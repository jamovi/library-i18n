msgstr "{k}-кратная КВ"

#: R/mstab.b.R
msgid ""
"{n} identical duplicate record(s) detected (matching Time, Batch, and "
"Response values). Please verify whether these represent intended analytical "
"replicates or inadvertent duplicate entries."
msgstr ""
"{n} идентичных дублирующих записей обнаружено (одинаковые Время, Серия и "
"Значение). Пожалуйста, проверьте, являются ли они аналитическими "
"повторностями или случайными дубликатами."

#: R/msrv.b.R
msgid "{pred} (AUC = {auc})"
msgstr "{pred} (AUC = {auc})"

#: R/msnp.b.R
msgid "{val} F"
msgstr "{val} Ж"

