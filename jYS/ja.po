msgstr "（切片）"

#: R/mroc.b.R
msgid "[{prc}% CI]"
msgstr "[{prc}%信頼区間]"

#: R/mcor.b.R
msgid "{ciWidth}% CI Lower"
msgstr "{ciWidth}%信頼区間下限"

#: R/mcor.b.R
msgid "{ciWidth}% CI Upper"
msgstr "{ciWidth}%信頼区間上限"

#: R/mlr.b.R
msgid "{k}-Fold CV"
msgstr "{k}分割交差検証"

#: R/mui.b.R
msgid "{varType} proposed decision"
msgstr "{varType} 決定案"

#: R/mmf.b.R
